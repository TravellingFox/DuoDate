# Copy to mobile/.env.local; see ../LOCAL_HANDOFF.md.
# Use an address reachable from your Android emulator/physical phone.
# This is bundled by Expo at build time; restart/rebuild after changing it.
EXPO_PUBLIC_BACKEND_URL="http://YOUR_COMPUTER_LAN_IP:3000"

# Optional VibeCode SDK project attribution/cache settings; not local requirements.
# EXPO_PUBLIC_VIBECODE_PROJECT_ID="REPLACE_WITH_VIBECODE_PROJECT_ID"
# VIBECODE_PROJECT_ID="REPLACE_WITH_VIBECODE_PROJECT_ID"
# VITE_VIBECODE_PROJECT_ID="REPLACE_WITH_VIBECODE_PROJECT_ID"
# NEXT_PUBLIC_VIBECODE_PROJECT_ID="REPLACE_WITH_VIBECODE_PROJECT_ID"
# METRO_CACHE_DIR="/ABSOLUTE/PATH/metro-cache"
# METRO_CACHE_HTTP_ENDPOINT="https://YOUR_METRO_CACHE_SERVICE"
# METRO_CACHE_VERSION="REPLACE_WITH_CACHE_NAMESPACE"

# Existing mobile .env contains this unused template name.
# EXPO_PUBLIC_EXAMPLE_ENV_VAR="REPLACE_WITH_EXAMPLE_VALUE"
# SDK maps polyfill only; maps are not used by the current app.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="REPLACE_WITH_PUBLIC_RESTRICTED_MAPS_KEY"
