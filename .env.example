# Local handoff reference; the repository does NOT load a root .env automatically.
# Copy backend variables into backend/.env.local and mobile variables into mobile/.env.local.
# See LOCAL_HANDOFF.md for provenance, defaults, setup, and conditional requirements.
# Values below are examples/placeholders, never exported credentials.

# MOBILE: required; reachable from the emulator/physical phone, not its own localhost.
EXPO_PUBLIC_BACKEND_URL="http://YOUR_COMPUTER_LAN_IP:3000"

# BACKEND: core configuration (env.ts supplies defaults when omitted).
PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
BACKEND_URL="http://YOUR_COMPUTER_LAN_IP:3000"
DUODATE_HOUSEHOLD_ID="duodate-household"
DUODATE_USER_ONE_ID="duodate-user-one"
DUODATE_USER_TWO_ID="duodate-user-two"
DUODATE_DEFAULT_TIME_ZONE="Europe/Berlin"
# Explicit true is allowed ONLY in development. Use false for tests/production.
DUODATE_DEV_AUTH_BYPASS=true
AUTH_SESSION_DAYS=180
AUTH_ROLLING_WINDOW_DAYS=30

# Required ONLY when running backend's provision command for private profiles.
# Uncomment and replace ALL six. Passphrases must be at least 12 characters.
# DUODATE_USER_ONE_DISPLAY_NAME="REPLACE_WITH_PROFILE_ONE_NAME"
# DUODATE_USER_ONE_HANDLE="REPLACE_WITH_PROFILE_ONE_HANDLE"
# DUODATE_USER_ONE_PASSPHRASE="REPLACE_WITH_STRONG_PRIVATE_PASSPHRASE_ONE"
# DUODATE_USER_TWO_DISPLAY_NAME="REPLACE_WITH_PROFILE_TWO_NAME"
# DUODATE_USER_TWO_HANDLE="REPLACE_WITH_PROFILE_TWO_HANDLE"
# DUODATE_USER_TWO_PASSPHRASE="REPLACE_WITH_STRONG_PRIVATE_PASSPHRASE_TWO"

# MEDIA: local encrypted files are the default. Optional directory override:
# MEDIA_STORAGE_DIRECTORY="/ABSOLUTE/PERSISTENT/PATH/private-media"
# S3-compatible storage requires ALL four values AND MEDIA_MASTER_KEY.
# MEDIA_STORAGE_ENDPOINT="https://YOUR_PRIVATE_S3_ENDPOINT"
# MEDIA_STORAGE_ACCESS_KEY_ID="REPLACE_WITH_STORAGE_ACCESS_KEY"
# MEDIA_STORAGE_SECRET_ACCESS_KEY="REPLACE_WITH_STORAGE_SECRET_KEY"
# MEDIA_STORAGE_BUCKET="REPLACE_WITH_PRIVATE_BUCKET_NAME"
MEDIA_STORAGE_REGION="auto"
# Local storage generates/persists a key if omitted; S3 requires your own key.
# Generate a real 32-byte base64 key: openssl rand -base64 32
# Do not use the literal placeholder below; it will fail validation.
# MEDIA_MASTER_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"
MEDIA_MASTER_KEY_VERSION=1
MEDIA_PHOTO_MAX_BYTES=20971520
MEDIA_VIDEO_MAX_BYTES=262144000
MEDIA_VOICE_NOTE_MAX_BYTES=52428800
MEDIA_PENDING_CLEANUP_MINUTES=60

# PUSH: optional access token if Expo push security is enabled.
# EXPO_PUSH_ACCESS_TOKEN="REPLACE_WITH_EXPO_PUSH_ACCESS_TOKEN"

# ENVIRONMENT="development"
# DATA_DIR="/ABSOLUTE/PERSISTENT/PATH/data"
# DATABASE_FILE="/ABSOLUTE/PERSISTENT/PATH/data/production.db"
# TMPDIR="/tmp"
# METRO_CACHE_DIR="/ABSOLUTE/PATH/metro-cache"
# METRO_CACHE_HTTP_ENDPOINT="https://YOUR_METRO_CACHE_SERVICE"
# METRO_CACHE_VERSION="REPLACE_WITH_CACHE_NAMESPACE"

# LOCAL ANDROID TOOLCHAIN: configure in your shell/IDE, not the app bundle.
# JAVA_HOME="/ABSOLUTE/PATH/TO/JDK17"
# ANDROID_HOME="/ABSOLUTE/PATH/TO/ANDROID_SDK"
# ANDROID_SDK_ROOT="/ABSOLUTE/PATH/TO/ANDROID_SDK"
# Existing web script supplies DARK_MODE; no separate configuration required.
# DARK_MODE="class"

# Unused mobile template variable (not needed for app behavior).
# EXPO_PUBLIC_EXAMPLE_ENV_VAR="REPLACE_WITH_EXAMPLE_VALUE"
# Unused backend template credential (no active AI API integration).
# OPENAI_API_KEY="REPLACE_ONLY_IF_YOU_LATER_CONFIGURE_AN_AI_INTEGRATION"
# Optional SDK maps key; current app does not use this maps integration.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="REPLACE_WITH_PUBLIC_RESTRICTED_MAPS_KEY"
